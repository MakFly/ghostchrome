# Binaries (anchored to repo root so they don't shadow .claude/skills/ghostchrome/)
/ghostchrome
/ghostchrome-mcp
dist/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets — never commit env files (a committed .env carried a trojan on origin)
.env
.env.*
!.env.example

# Go
*.exe
*.test
*.out

# Python SDK artifacts
__pycache__/
*.pyc
sdk/python/.venv/
sdk/python/*.egg-info/

# ig index
.ig/

# Recipes / config
*.yaml

# Playwright
.playwright*

# Benchmark transient artifacts (regenerated by ./benchmark/run-bench.sh)
benchmark/trials/
benchmark/.fixtures.log
benchmark/.serve.log
benchmark/results.json
benchmark/results-warm.json
/bin/

# crew worktrees (transient, per-task isolation)
.claude/worktrees/

# Private scraping recipes — kept on disk, never committed.
# Composed into the binary only via `go build -tags recipes .`
# (build tag already excludes them from the default binary).
/packages/leboncoin/
/packages/linkedin/
/packages/instagram/
/packages/cars-listings/
/cmd/leboncoin.go
/cmd/linkedin.go
/cmd/instagram.go
/cmd/cars_listings.go
